APP_NAME=FleetConnect API
APP_ENV=development
APP_VERSION=0.1.0
API_V1_PREFIX=/api/v1
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO
AUTO_CREATE_TABLES=false
DB_NAME=flotte_telephonique
DB_USER=postgres
DB_PASSWORD=ilham123
DB_HOST=localhost
DB_PORT=5432
DB_SCHEMA=public
DATABASE_URL=postgresql+psycopg2://postgres:ilham123@localhost:5432/flotte_telephonique
SECRET_KEY=change-me-before-production
REFRESH_SECRET_KEY=change-me-before-production
PASSWORD_RESET_SECRET_KEY=change-me-before-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_MINUTES=10080
PASSWORD_RESET_CODE_EXPIRE_MINUTES=15
FRONTEND_URL=http://localhost:5173
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-google-address@gmail.com
SMTP_PASSWORD=your-gmail-app-password
SMTP_FROM_EMAIL=your-google-address@gmail.com
SMTP_FROM_NAME=BC SKILLS FleetConnect
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=20
# Google OAuth: create a "Web application" client in Google Cloud Auth Platform / Clients
# Authorized redirect URI (must match exactly): http://127.0.0.1:8000/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/v1/auth/google/callback
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_VISION_MODEL=llava
OLLAMA_TIMEOUT_SECONDS=8
OLLAMA_VISION_TIMEOUT_SECONDS=120
IMAGE_VISION_TIMEOUT_SECONDS=120
# Microsoft OAuth: create an app registration in Microsoft Entra ID
# Redirect URI (Web) must match exactly: http://127.0.0.1:8000/api/v1/auth/microsoft/callback
MICROSOFT_CLIENT_ID=your-microsoft-client-id
MICROSOFT_CLIENT_SECRET=your-microsoft-client-secret
MICROSOFT_REDIRECT_URI=http://127.0.0.1:8000/api/v1/auth/microsoft/callback
MICROSOFT_TENANT_ID=common
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174
TRUSTED_HOSTS=localhost,127.0.0.1,*.localhost
HTTPS_REDIRECT=false
SECURITY_HEADERS_ENABLED=true
DEFAULT_PAGE_SIZE=50
MAX_PAGE_SIZE=100
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
DEFAULT_ADMIN_NAME=Admin BC Skills
DEFAULT_ADMIN_EMAIL=admin@bcskills.ma
DEFAULT_ADMIN_PASSWORD=Admin123!
