VITE_API_URL=/api/v1
VITE_BACKEND_TARGET=http://127.0.0.1:8000
VITE_DEV_PORT=5173

# Activez HTTPS en local uniquement avec des certificats hors depot.
# Exemple avec mkcert genere pour localhost et votre IP LAN.
# VITE_DEV_HTTPS=true
# VITE_DEV_HTTPS_KEY_PATH=C:/Users/<vous>/certs/fleetconnect-dev-key.pem
# VITE_DEV_HTTPS_CERT_PATH=C:/Users/<vous>/certs/fleetconnect-dev-cert.pem
# VITE_DEV_HTTPS_CA_PATH=C:/Users/<vous>/certs/rootCA.pem

# Si vous exposez Vite derriere un proxy HTTPS local, alignez le host/protocole HMR.
# VITE_HMR_HOST=192.168.0.131
# VITE_HMR_PROTOCOL=wss
